# ============================================================
# .gitignore —— 告诉 git「这些文件不要上传」
# 每行是一种匹配规则，匹配到的文件会被 git 自动忽略
# ============================================================

# ---------- 敏感信息（绝对不能上传，安全第一）----------

# .env 环境变量文件（里面常放数据库密码、API 密钥）
.env
.env.*
!.env.example

# API 密钥、token、证书
*.key
*.token
*.secret
secrets.*
secret.*
credentials.*

# 密码相关文件
password*
*.pass

# ---------- 依赖目录（能重新下载，不用上传）----------

# Node.js 依赖
node_modules/

# Python 依赖和缓存
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# 其他语言的构建产物 / 依赖
target/
dist/
build/
.gradle/
# 只忽略仓库根目录的 vendor/（PHP/Composer 习惯）。
# Day 30：原来写的是 `vendor/`，会连 `js/vendor/` 一起忽略——
# 而 js/vendor/xlsx.full.min.js 是第三方解析库，必须进仓库，
# 否则别人 clone 下来导入功能直接失效。
/vendor/
bower_components/
packages/

# ---------- 本地数据库文件 ----------
*.db
*.sqlite
*.sqlite3
*.mdb
*.ldb
*.accdb

# ---------- 系统 / 编辑器垃圾文件 ----------
.DS_Store
Thumbs.db
Desktop.ini
*.log
.vscode/
.idea/
*.swp
*~

# ---------- 临时文件 ----------
*.tmp
*.temp

# 课表样本文件（真实教务数据，不进仓库）
samples/

# ============ 安卓打包相关（Capacitor）============

# 本机 SDK 路径，只对这台电脑有效
android/local.properties

# 签名文件（含私钥，泄露等于别人能冒充你发版）
*.jks
*.keystore
android/keystore.properties

# 打包源（由 tools/build-www.js 从根目录生成，属于产物）
www/

# Gradle / 构建产物（.gitignore 上方已有 build/ 与 .gradle/，这里补 Capacitor 特有路径）
android/.gradle/
android/app/build/
android/build/

# 打包出来的安装包（体积大，通过网盘分发，不进仓库）
*.apk
*.aab
